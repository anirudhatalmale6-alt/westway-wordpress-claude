{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "720px", "wideSize": "1200px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "forest", "name": "Forest", "color": "#1E3A2F" },
        { "slug": "forest-line", "name": "Forest line", "color": "#35513F" },
        { "slug": "ink", "name": "Ink", "color": "#3F4A42" },
        { "slug": "muted", "name": "Muted", "color": "#5A6158" },
        { "slug": "gold", "name": "Gold", "color": "#B08A3E" },
        { "slug": "sand", "name": "Sand", "color": "#D4BC85" },
        { "slug": "cream", "name": "Cream", "color": "#F3EEE3" },
        { "slug": "paper", "name": "Paper", "color": "#FBF8F0" },
        { "slug": "stone", "name": "Stone", "color": "#EAE2CF" },
        { "slug": "line", "name": "Line", "color": "#E0D8C6" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        { "slug": "sans", "name": "Geist", "fontFamily": "'Geist', system-ui, sans-serif" },
        { "slug": "serif", "name": "Newsreader", "fontFamily": "'Newsreader', Georgia, serif" }
      ]
    },
    "spacing": { "units": ["px", "%", "em", "rem", "vw"] }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--cream)", "text": "var(--wp--preset--color--forest)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontSize": "16px", "lineHeight": "1.6" },
    "spacing": { "padding": { "left": "24px", "right": "24px" }, "blockGap": "16px" },
    "elements": {
      "link": { "color": { "text": "var(--wp--preset--color--forest)" } },
      "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontWeight": "400", "lineHeight": "1.1" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--forest)", "text": "var(--wp--preset--color--paper)" },
        "border": { "radius": "12px" },
        "typography": { "fontWeight": "500", "fontSize": "15px" },
        "spacing": { "padding": { "top": "12px", "bottom": "12px", "left": "20px", "right": "20px" } }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
